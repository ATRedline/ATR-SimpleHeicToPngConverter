<Window x:Class="SimpleHeicToPngConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleHeicToPngConverter"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="ATR SimpleHeicToPngConverter" 
        Height="450" 
        Width="800"
        MinWidth="600"
        MinHeight="450">
    <Grid Margin="15, 15, 15, 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="/Resources/heic.png" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"></Image>
            <Image Source="/Resources/png.png" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"></Image>
        </Grid>
        <Grid Grid.Row="1" Margin="0, 20, 0, 20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Top">Формат (Output file format):</Label>
            <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="OutputPngTypeCheckbox" Grid.Column="0" VerticalAlignment="Center" GroupName="Quality" IsChecked="True" Click="OutputPngTypeCheckbox_Click" >PNG</RadioButton>
                <RadioButton x:Name="OutputJpgTypeCheckbox" Grid.Column="1" VerticalAlignment="Center" GroupName="Quality" Margin="20, 0, 0, 0" Click="OutputJpgTypeCheckbox_Click">JPG</RadioButton>
            </Grid>
            <Label Grid.Row="1" x:Name="SliderLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0, 0, 20, 0">Степень сжатия (Compression rate):</Label>
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="QualitySlider" Grid.Column="0" Minimum="0" Maximum="100" Value="0" Margin="0, 10, 0, 0" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="QualitySlider_ValueChanged" TickPlacement="BottomRight"/>
                <Label x:Name="QualityLabel" Grid.Column="1" Margin="7, 0, 0, 0" VerticalAlignment="Center" HorizontalAlignment="Right">0%</Label>
            </Grid>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Height="50" Grid.Column="0" Click="SayThanks_Button_Click">
                <Label>Сказать спасибо</Label>
            </Button>
            <Button Height="50" x:Name="Convert_Button" Grid.Column="1" Margin="7, 0, 0, 0" Click="Convert_Button_Click" >Конвертировать .heic to .png (Convert .heic to .png)</Button>
        </Grid>
        <ProgressBar x:Name="ConvertationProgressBar" Grid.Row="3" Minimum="0" Maximum="100" Height="5" Margin="0, 5, 0, 5" Visibility="Hidden"></ProgressBar>
    </Grid>
</Window>
